* text=auto eol=lf

# Double-click files and helper scripts need CRLF in the working tree:
# cmd.exe and Windows PowerShell 5.1 stumble over LF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# A colleague opens the guide with a double click in Notepad. Without CRLF
# Notepad shows it as a single line (design D22).
LIES-MICH-ZUERST.txt text eol=crlf

VERSION text eol=lf

*.wav binary
*.lnk binary
*.zip binary
*.ico binary
